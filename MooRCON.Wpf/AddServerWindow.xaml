<Window x:Class="MooRCON.Wpf.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Main}"
        Title="Добавить сервер" Icon="Assets/app.ico"
        Width="440" Height="380" MinWidth="440" MinHeight="380"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
            <TextBlock Text="Добавить сервер" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Strong}"/>
            <Button Content="&#xE8BB;" Style="{StaticResource Btn.Caption}" HorizontalAlignment="Right"
                    Click="OnCancel"/>
        </Grid>

        <!-- Форма (фон как у основной программы) -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Bg.Surface}">
            <StackPanel VerticalAlignment="Top" Margin="20,18,20,0">
                <TextBlock Text="Имя сервера" Foreground="{DynamicResource Brush.Text.Label}" FontSize="12" Margin="2,0,0,6"/>
                <TextBox x:Name="NameBox" Style="{StaticResource Field.Text}"/>

                <TextBlock Text="Адрес (IP или hostname)" Foreground="{DynamicResource Brush.Text.Label}"
                           FontSize="12" Margin="2,14,0,6"/>
                <TextBox x:Name="HostBox" Style="{StaticResource Field.Text}"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Порт RCON" Foreground="{DynamicResource Brush.Text.Label}" FontSize="12" Margin="2,0,0,6"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource Field.Text}" Text="25575"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Пароль RCON" Foreground="{DynamicResource Brush.Text.Label}" FontSize="12" Margin="2,0,0,6"/>
                        <PasswordBox x:Name="PassBox" Style="{StaticResource Field.Password}"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12"
                           Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Кнопки прижаты к низу окна -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="20">
                <Button Content="Отмена" Style="{StaticResource Btn.Secondary}" Width="110" Click="OnCancel"/>
                <Button Content="Сохранить" Style="{StaticResource Btn.Accent}" Width="130" Margin="10,0,0,0"
                        Click="OnSave"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
