<Window x:Class="MooRCON.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MooRCON.Wpf.ViewModels"
        xmlns:views="clr-namespace:MooRCON.Wpf.Views"
        xmlns:conv="clr-namespace:MooRCON.Wpf.Converters"
        Style="{StaticResource Window.Main}"
        Title="MooRCON" Icon="Assets/app.ico"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Элемент списка серверов в сайдбаре -->
        <Style x:Key="ServerItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Card}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладка сессии: фиксированный размер, фон активной, ховер-анимация -->
        <Style x:Key="SessionTabItem" TargetType="TabItem">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="hover" Background="{DynamicResource Brush.Bg.Card}"
                                    CornerRadius="8,8,0,0" Opacity="0"/>
                            <Border x:Name="sel" Background="{DynamicResource Brush.Bg.Surface}"
                                    CornerRadius="8,8,0,0" Opacity="0"
                                    BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,2"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch" Margin="12,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="sel" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка закрытия вкладки -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Faint}"/>
            <Setter Property="Content" Value="&#xE711;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Danger.Bg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ЗАГОЛОВОК ОКНА ==================== -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <Image Source="Assets/app.ico" Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="MooRCON" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Strong}"/>
                <TextBlock Text="RCON-клиент" Margin="8,0,0,0"
                           VerticalAlignment="Center" FontSize="12.5"
                           Foreground="{DynamicResource Brush.Text.Faint}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource Btn.Caption}"
                        Click="OnMinimize"/>
                <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource Btn.Caption}"
                        Click="OnMaximizeRestore"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource Btn.Caption}"
                        Click="OnClose"/>
            </StackPanel>
        </Grid>

        <!-- ==================== ТЕЛО ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Сайдбар со списком серверов -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bg.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="СЕРВЕРЫ" Foreground="{DynamicResource Brush.Text.Label}"
                               FontSize="11" FontWeight="SemiBold" Margin="18,16,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Servers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ServerItemButton}"
                                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Strong}"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{DynamicResource Brush.Text.Faint}" FontSize="11" Margin="0,2,0,0">
                                                <Run Text="{Binding IpHost, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding RconPort, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Обновить список" Style="{StaticResource Btn.Secondary}"
                            Margin="12" Command="{Binding RefreshServersCommand}"/>
                </Grid>
            </Border>

            <!-- Область вкладок -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Bg.Surface}">
                <Grid>
                    <!-- Заглушка, когда вкладок нет -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="Нет открытых подключений" Foreground="{DynamicResource Brush.Text.Muted}"
                                   FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выберите сервер слева, чтобы открыть вкладку" Foreground="{DynamicResource Brush.Text.Faint}"
                                   FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TabControl Style="{StaticResource Tabs.Main}"
                                Margin="8,6,8,8"
                                ItemsSource="{Binding Sessions}"
                                SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                ItemContainerStyle="{StaticResource SessionTabItem}"
                                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Offline}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Header}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2" Style="{StaticResource TabCloseButton}"
                                            Command="{Binding CloseCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <views:SessionView/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
