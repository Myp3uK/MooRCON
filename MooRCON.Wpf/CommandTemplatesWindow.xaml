<Window x:Class="MooRCON.Wpf.CommandTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Main}"
        Title="Заготовки команд" Icon="Assets/app.ico"
        Width="820" Height="710" MinWidth="780" MinHeight="620"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Элемент списка заготовок: подпись и сам шаблон под ней -->
        <Style x:Key="TemplateItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Bg.Card}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Soft18}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
            <TextBlock Text="Заготовки команд" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Strong}"/>
            <Button Content="&#xE8BB;" Style="{StaticResource Btn.Caption}" HorizontalAlignment="Right"
                    Click="OnCancel"/>
        </Grid>

        <Grid Grid.Row="1" Background="{DynamicResource Brush.Bg.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Список заготовок -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="16,16,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="10" Background="{DynamicResource Brush.Bg.Sidebar}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" Padding="4">
                    <ListBox x:Name="TemplateList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource TemplateItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnTemplateSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource Brush.Text.Strong}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Preview}" FontSize="11" Margin="0,2,0,0"
                                               FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{DynamicResource Brush.Text.Faint}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="+ Добавить" Style="{StaticResource Btn.Secondary}" Width="118"
                            Click="OnAdd"/>
                    <Button Content="Удалить" Style="{StaticResource Btn.Danger}"
                            Width="110" Margin="8,0,0,0" Click="OnDelete"/>
                </StackPanel>
            </Grid>

            <!-- Форма заготовки -->
            <ScrollViewer Grid.Row="0" Grid.Column="1" Margin="8,16,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel">
                    <TextBlock Text="Название кнопки" Foreground="{DynamicResource Brush.Text.Label}"
                               FontSize="12" Margin="2,0,0,6"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource Field.Text}"
                             TextChanged="OnNameChanged"/>

                    <TextBlock Text="Шаблон команды" Foreground="{DynamicResource Brush.Text.Label}"
                               FontSize="12" Margin="2,14,0,6"/>
                    <TextBox x:Name="TemplateBox" Style="{StaticResource Field.Area}"
                             FontFamily="{StaticResource Font.Mono}"
                             TextChanged="OnTemplateChanged"/>
                    <TextBlock Margin="2,6,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Faintest}"
                               Text="Каждая строка — отдельная команда. Они уходят по очереди, следующая после ответа на предыдущую; если одна сорвётся, остальные не пойдут."/>

                    <TextBlock Text="Заметка (подсказка на кнопке)" Foreground="{DynamicResource Brush.Text.Label}"
                               FontSize="12" Margin="2,14,0,6"/>
                    <TextBox x:Name="CommentBox" Style="{StaticResource Field.Text}"
                             TextChanged="OnCommentChanged"/>

                    <CheckBox x:Name="ConfirmCheck" Content="Спрашивать подтверждение перед отправкой"
                              Style="{StaticResource Check.Main}" Margin="2,16,0,0"
                              Click="OnConfirmChanged"/>
                    <CheckBox x:Name="ServerCheck" Style="{StaticResource Check.Main}" Margin="2,10,0,0"
                              Click="OnServerCheckChanged"/>

                    <!-- Шпаргалка по подстановкам -->
                    <Border CornerRadius="10" Background="{DynamicResource Brush.Bg.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Input}" BorderThickness="1"
                            Padding="12,10" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="ПОДСТАНОВКИ" Foreground="{DynamicResource Brush.Text.Label}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12"
                                       LineHeight="19" TextWrapping="Wrap">
                                <Run Text="{}{idx}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— индекс игрока в listplayers; перечитывается заново перед каждой отправкой."/>
                                <LineBreak/>
                                <Run Text="{}{char} {player}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— имя персонажа и имя аккаунта."/>
                                <LineBreak/>
                                <Run Text="{}{userid} {platformid} {platform}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— идентификаторы игрока и платформа."/>
                                <LineBreak/>
                                <Run Text="{}{?Подпись}   {?Подпись=по умолчанию}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— спросить значение перед отправкой."/>
                                <LineBreak/>
                                <Run Text="{}{Подпись}   {Подпись+30}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— то же значение ещё раз, можно со сдвигом (+, -, *)."/>
                                <LineBreak/>
                                <Run Text="{}{?Стат=6|6:Основной урон|7:Второй урон}" FontFamily="{StaticResource Font.Mono}"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Run Text="— выбор из списка: варианты через «|», подпись после «:»."/>
                            </TextBlock>
                            <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Faint}"
                                       Text="Точные имена команд своего сервера смотрите в выводе help — у разных сборок они различаются."/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="12"
                               Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Нижняя полоса -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="16">
                <Button Content="Открыть commands.json" Style="{StaticResource Btn.Secondary}"
                        HorizontalAlignment="Left" Width="200" Click="OnOpenFile"
                        ToolTip="Файл перечитывается при запуске программы. Правки в нём пропадут, если потом нажать «Сохранить» здесь."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Style="{StaticResource Btn.Secondary}" Width="110" Click="OnCancel"/>
                    <Button Content="Сохранить" Style="{StaticResource Btn.Accent}" Width="130" Margin="10,0,0,0"
                            Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
