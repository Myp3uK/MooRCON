<UserControl x:Class="MooRCON.Wpf.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" IsVisibleChanged="OnIsVisibleChanged"
             PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Вывод консоли -->
        <Border Grid.Row="0" CornerRadius="10" Background="{DynamicResource Brush.Bg.TitleBar}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <TextBox x:Name="OutputBox"
                     Text="{Binding Output, Mode=OneWay}"
                     TextChanged="OutputBox_TextChanged"
                     IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Brush.Text.Log}"
                     FontFamily="Consolas" FontSize="13"
                     Padding="10" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Статус-бар -->
        <Grid Grid.Row="1" Margin="2,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Offline}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Text.Secondary}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  •  " Foreground="{DynamicResource Brush.Text.Faint}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Endpoint}" Foreground="{DynamicResource Brush.Text.Muted}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="Держать соединение" VerticalAlignment="Center"
                          Foreground="{DynamicResource Brush.Text.Muted}"
                          IsChecked="{Binding KeepAliveEnabled}"/>
                <Button Content="Переподключить" Style="{StaticResource Btn.Secondary}"
                        Margin="12,0,0,0" Height="30" Padding="12,0"
                        Command="{Binding ReconnectCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Ввод команды -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource Field.Text}"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InputBox_KeyDown">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Отправить" Style="{StaticResource Btn.Accent}"
                    Height="40" Margin="10,0,0,0" Command="{Binding SendCommand}"/>
        </Grid>
    </Grid>
</UserControl>
