<Window x:Class="MooRCON.Wpf.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Window.Main}"
        Title="Подтверждение" Icon="Assets/app.ico"
        Width="430" MinWidth="430" MinHeight="210" MaxHeight="620"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Bg.TitleBar}">
            <TextBlock x:Name="TitleText" Text="Подтверждение" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Strong}"/>
            <Button Content="&#xE8BB;" Style="{StaticResource Btn.Caption}" HorizontalAlignment="Right"
                    Click="OnCancel"/>
        </Grid>

        <!-- Текст растёт вместе с окном: подтверждать приходится и цепочки из нескольких команд -->
        <Grid Grid.Row="1" Background="{DynamicResource Brush.Bg.Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="90"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" Margin="20,20,20,0" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="13" LineHeight="20"/>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Btn.Secondary}"
                        Width="110" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Content="Удалить" Style="{StaticResource Btn.Danger}"
                        Width="130" Margin="10,0,0,0" Click="OnConfirm"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
