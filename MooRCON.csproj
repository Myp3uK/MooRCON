<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>MyLogo.ico</ApplicationIcon>
    <!-- Консольный проект лежит в корне репозитория, поэтому SDK по умолчанию
         захватывал бы .cs из соседних проектов. Исключаем их папки. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);MooRCON.Core\**;MooRCON.Wpf\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="MyLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.50.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ради общей реализации протокола RCON: остальную логику консоль держит свою. -->
    <ProjectReference Include="MooRCON.Core\MooRCON.Core.csproj" />
  </ItemGroup>

</Project>
